{
  "mcpServers": {
    "context7": {
      "command": "node",
      "args": ["${workspaceFolder}/.cursor/mcp/run-mcp.cjs", "context7"]
    },
    "sequential-thinking": {
      "command": "node",
      "args": ["${workspaceFolder}/.cursor/mcp/run-mcp.cjs", "sequential-thinking"]
    },
    "playwright": {
      "command": "node",
      "args": ["${workspaceFolder}/.cursor/mcp/run-mcp.cjs", "playwright"]
    },
    "chrome-devtools": {
      "command": "node",
      "args": ["${workspaceFolder}/.cursor/mcp/run-mcp.cjs", "chrome-devtools"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "postgresql://velmor:velmor@localhost:5432/velmor"
      }
    },
    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    },
    "langfuse-docs": {
      "url": "https://langfuse.com/api/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "stripe": {
      "url": "https://mcp.stripe.com"
    },
    "codex": {
      "command": "node",
      "args": ["${workspaceFolder}/.cursor/mcp/codex-launcher.cjs", "mcp-server"]
    }
  }
}
