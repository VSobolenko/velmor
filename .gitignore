# Environment files — every .env is local only
.env
.env.*
!.env.example

# Secrets and credentials
.credentials
google-services*.json
google-service-account.json
*.pem
*.key

# Agent scratch state
.superpowers/
.worktrees/
# Codex worker ledger (meta, log, err, last message, prompts) and the edit ledger.
# Orchestration state, not source; durable rulings belong in OpenSpec or harness/.
.velmor/

# Local data and artifacts
data/
artifacts/
extracted_images/

# Git bundles are a transfer artifact, not history: they carry a full copy of
# the repository and are rebuilt per deploy.
*.bundle

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
.Python
/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node (storefront presentation layer)
node_modules/
.next/
out/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Type checkers and linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pixi
__pypackages__/

# Local service state
.prefect/
*.rdb
*.aof
*.pid
celerybeat-schedule
celerybeat.pid

# Logs and databases
*.log
*.db
db.sqlite3
db.sqlite3-journal

# Saleor GraphQL schema is owned by Saleor and fetched via introspection;
# never commit a dumped copy.
packages/services/src/saleor/graphql/schema.graphql

# Notebooks
.ipynb_checkpoints

# IDE / editor (local settings)
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject

# OS files
.DS_Store
Thumbs.db

# Word/Excel lock files
~$*.doc
~$*.docx
~$*.xlsx
