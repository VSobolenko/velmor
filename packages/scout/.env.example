# Scout agent - discovery profile.
#
# Copy to .env.dev and fill in. Every variable below is required: SettingsLoader
# raises ConfigurationError at bootstrap when one is missing, on purpose. A
# half-configured crawler that silently returns empty pages is worse than a
# process that refuses to start.
#
# .env.<profile> files are git-ignored. Never put a real credential in a file that
# is committed. secret-guard.cjs blocks the write if you try.

# Platform baseline (PlatformSettings). Required by every process.
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://velmor:velmor@localhost:5432/velmor
REDIS_URL=redis://localhost:6379/0
# Write token from logfire. Leave the placeholder only in this file, never in .env.dev.
LOGFIRE_TOKEN=your-logfire-write-token

# Discovery. Comma-separated search terms; at least one value is required.
SCOUT_QUERIES=public domain music, open source icons, cc0 illustrations
SCOUT_PAGE_LIMIT=20
SCOUT_INTERVAL_SECONDS=3600
SCOUT_CONCURRENCY=4

# Credentials for enabled sources, named by each SourceSpec.required_env in
# packages/services/src/sources/source_registry.py. A source that is enabled
# without its keys fails startup with SourceNotConfiguredError naming them.
#
# openverse is enabled and requires nothing.
# GITHUB_TOKEN=            # required by the 'github' source when enabled
# HUGGINGFACE_TOKEN=       # required by the 'huggingface' source when enabled
