# Auditor agent - rights verification profile.
#
# Copy to .env.dev and fill in. Every variable below is required: SettingsLoader
# raises ConfigurationError at bootstrap when one is missing, on purpose.
#
# .env.<profile> files are git-ignored. Never put a real credential in a file that
# is committed. secret-guard.cjs blocks the write if you try.

# Platform baseline (PlatformSettings). Required by every process.
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://velmor:velmor@localhost:5432/velmor
REDIS_URL=redis://localhost:6379/0
LOGFIRE_TOKEN=your-logfire-write-token

# Verification.
# The interpreter is the only component that talks to a model, and its output is
# evidence, never a verdict. See .cursor/skills/rights-engine/SKILL.md.
AUDITOR_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# How many times the graph may re-investigate before routing to review. This is
# the hard bound that stops a non-converging run.
AUDITOR_MAX_INVESTIGATION_ATTEMPTS=3

# Below this confidence an interpreted rights statement is not trusted enough to
# decide automatically: the graph interrupts and asks a human.
AUDITOR_ESCALATION_CONFIDENCE=0.85

AUDITOR_BATCH_SIZE=25
AUDITOR_INTERVAL_SECONDS=1800
