# Storefront profile - the Proofbasket catalogue page.
#
# Copy to .env.dev and fill in. Every variable below is required: SettingsLoader
# raises ConfigurationError at bootstrap when one is missing, on purpose.
#
# .env.<profile> files are git-ignored. Never put a real credential in a file that
# is committed. secret-guard.cjs blocks the write if you try.

# Platform baseline (PlatformSettings). Required by every process.
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://velmor:velmor@localhost:5432/velmor
REDIS_URL=redis://localhost:6379/0
# Write token from logfire. Leave the placeholder only in this file, never in .env.dev.
LOGFIRE_TOKEN=your-logfire-write-token
