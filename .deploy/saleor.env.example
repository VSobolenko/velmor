# Copy to /opt/velmor/saleor.env (mode 600). Fill real values on the server only.
# Never commit a filled saleor.env.

SECRET_KEY=replace-with-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_CLIENT_HOSTS=127.0.0.1,localhost,http://127.0.0.1:9000
PUBLIC_URL=http://127.0.0.1:8001/
DEFAULT_FROM_EMAIL=noreply@localhost
DEFAULT_CHANNEL_SLUG=default-channel
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# Separate Postgres database on velmor-postgres (user velmor). Do not use the velmor DB.
DATABASE_URL=postgres://velmor:REPLACE_POSTGRES_PASSWORD@postgres:5432/saleor

# Redis logical DB 1 (leave /0 for Velmor). Cache and Celery share index 1 on this host.
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# Required when DEBUG=False. Double-quote so Compose expands \n to real newlines.
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE\n-----END RSA PRIVATE KEY-----"

# Optional: dashboard browser target (also settable on the dashboard service).
SALEOR_DASHBOARD_API_URL=http://127.0.0.1:8001/graphql/

# Staff bootstrap (used by deploy-saleor.sh; not read by Saleor itself).
SALEOR_SUPERUSER_EMAIL=admin@example.com
SALEOR_SUPERUSER_PASSWORD=replace-with-strong-password
